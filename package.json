{
  "name": "archway-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/browser.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src shared server tests scripts docs .github vite.config.ts index.html package.json tsconfig.json .prettierrc.json README.md AGENTS.md CONTRIBUTING.md SECURITY.md CHANGELOG.md",
    "format:check": "prettier --check src shared server tests scripts docs .github vite.config.ts index.html package.json tsconfig.json .prettierrc.json README.md AGENTS.md CONTRIBUTING.md SECURITY.md CHANGELOG.md",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "docs:check": "tsx scripts/generate-docs.ts --check && tsx scripts/check-docs.ts",
    "verify": "npm run format:check && npm run docs:check && npm run check && npm test && npm run build",
    "test:milestones": "tsx tests/milestones-browser.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:performance": "tsx tests/performance-browser.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.1",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT"
}
