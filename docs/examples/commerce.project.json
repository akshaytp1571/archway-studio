{
  "name": "Commerce platform",
  "description": "A service-oriented storefront, from first click to checkout.",
  "components": [
    {
      "id": "web-client",
      "kind": "client",
      "name": "Web storefront",
      "description": "The customer-facing shopping experience. Browses products and places orders.",
      "technology": "Next.js",
      "owner": "Platform team",
      "tags": ["public"],
      "boundaryId": null,
      "metadata": {}
    },
    {
      "id": "api-gateway",
      "kind": "gateway",
      "name": "API gateway",
      "description": "Routes authenticated requests to application services. Applies rate limits.",
      "technology": "Kong",
      "owner": "Platform team",
      "tags": ["entrypoint"],
      "boundaryId": "application",
      "metadata": {}
    },
    {
      "id": "catalog-service",
      "kind": "service",
      "name": "Catalog service",
      "description": "Owns product discovery, inventory lookup, and catalog search.",
      "technology": "Node.js",
      "owner": "Platform team",
      "tags": ["core"],
      "boundaryId": "application",
      "metadata": {}
    },
    {
      "id": "order-service",
      "kind": "service",
      "name": "Order service",
      "description": "Coordinates checkout, creates orders, and integrates with payments.",
      "technology": "TypeScript",
      "owner": "Platform team",
      "tags": ["core"],
      "boundaryId": "application",
      "metadata": {}
    },
    {
      "id": "identity-service",
      "kind": "service",
      "name": "Identity service",
      "description": "Manages customer authentication, authorization, and session lifecycle.",
      "technology": "Keycloak",
      "owner": "Platform team",
      "tags": ["security"],
      "boundaryId": "application",
      "metadata": {}
    },
    {
      "id": "primary-database",
      "kind": "database",
      "name": "Commerce database",
      "description": "Durable storage for products and orders. Schemas are owned by their services.",
      "technology": "PostgreSQL",
      "owner": "Platform team",
      "tags": ["persistent"],
      "boundaryId": "data",
      "metadata": {}
    },
    {
      "id": "session-store",
      "kind": "database",
      "name": "Session store",
      "description": "Short-lived session and token state with time-based expiry.",
      "technology": "Redis",
      "owner": "Platform team",
      "tags": ["ephemeral"],
      "boundaryId": "data",
      "metadata": {}
    },
    {
      "id": "payment-provider",
      "kind": "external",
      "name": "Payment provider",
      "description": "External payment authorization and settlement.",
      "technology": "Stripe",
      "owner": "Platform team",
      "tags": ["third-party"],
      "boundaryId": null,
      "metadata": {}
    }
  ],
