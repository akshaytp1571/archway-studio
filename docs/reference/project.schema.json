{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "default": "", "type": "string", "maxLength": 2000 },
    "components": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "kind": {
            "type": "string",
            "enum": ["client", "gateway", "service", "database", "queue", "external"]
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "default": "", "type": "string", "maxLength": 2000 },
          "technology": { "default": "", "type": "string", "maxLength": 100 },
          "owner": { "default": "", "type": "string", "maxLength": 100 },
          "tags": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "boundaryId": {
            "default": null,
            "anyOf": [
              { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
              { "type": "null" }
            ]
          },
          "metadata": {
            "default": {},
            "type": "object",
            "propertyNames": { "type": "string", "maxLength": 80 },
            "additionalProperties": { "type": "string", "maxLength": 1000 }
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "description",
          "technology",
          "owner",
          "tags",
          "boundaryId",
          "metadata"
        ],
        "additionalProperties": false
      }
    },
    "relationships": {
      "maxItems": 1500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "source": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "target": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "label": { "default": "", "type": "string", "maxLength": 100 },
          "protocol": { "default": "", "type": "string", "maxLength": 60 },
          "interaction": { "default": "sync", "type": "string", "enum": ["sync", "async"] },
          "description": { "default": "", "type": "string", "maxLength": 1000 }
        },
        "required": ["id", "source", "target", "label", "protocol", "interaction", "description"],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "default": "system", "type": "string", "enum": ["system", "trust", "network"] },
          "description": { "default": "", "type": "string", "maxLength": 1000 }
        },
        "required": ["id", "name", "type", "description"],
        "additionalProperties": false
      }
    },
    "views": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "default": "", "type": "string", "maxLength": 1000 },
          "kinds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["client", "gateway", "service", "database", "queue", "external"]
            }
          },
          "layout": {
            "type": "object",
            "properties": {
              "direction": { "default": "LR", "type": "string", "enum": ["LR", "TB"] },
              "positions": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
                    "y": { "type": "number", "minimum": -20000, "maximum": 20000 }
                  },
                  "required": ["x", "y"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["direction", "positions"],
            "additionalProperties": false
          }
        },
        "required": ["id", "name", "description", "kinds", "layout"],
        "additionalProperties": false
      }
    },
    "schemaVersion": { "type": "number", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "name",
    "description",
    "components",
    "relationships",
    "boundaries",
    "views",
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
